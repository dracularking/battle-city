{
  "name": "battle-city",
  "version": "0.4.0-SNAPSHOT",
  "description": "Battle city remake built with react.",
  "author": "Shi Feichao <842351815@qq.com> (https://shinima.github.io)",
  "main": "electron/main.js",
  "scripts": {
    "start": "webpack-dev-server --mode=development",
    "build": "webpack --mode=production && copyfiles sound/* dist",
    "electron": "electron .",
    "electron:build": "yarn build && electron-builder --win"
  },
  "dependencies": {
    "@types/history": "^4.6.2",
    "@types/lodash": "^4.14.105",
    "@types/node": "^10.9.4",
    "@types/prop-types": "^15.5.2",
    "@types/react": "^15.0.21",
    "@types/react-dom": "^15.5.1",
    "@types/react-hot-loader": "^4.1.0",
    "@types/react-redux": "^6.0.8",
    "@types/react-router-dom": "^4.2.5",
    "@types/react-router-redux": "^5.0.12",
    "@types/recompose": "^0.26.5",
    "classnames": "^2.2.5",
    "copyfiles": "^2.1.0",
    "core-js": "^2.5.5",
    "file-saver": "^1.3.3",
    "history": "^4.7.2",
    "immutable": "4.0.0-rc.9",
    "lodash": "^4.17.5",
    "normalize.css": "^8.0.0",
    "prop-types": "^15.6.1",
    "react": "^15.3.2",
    "react-dom": "^15.3.2",
    "react-hot-loader": "^4.0.0",
    "react-redux": "^5.0.7",
    "react-router-dom": "^4.2.2",
    "react-router-redux": "5.0.0-alpha.9",
    "recompose": "^0.30.0",
    "redux": "^4.0.0",
    "redux-saga": "1.0.2"
  },
  "devDependencies": {
    "@types/classnames": "^2.2.0",
    "@types/file-saver": "^1.3.0",
    "babel-core": "^6.26.0",
    "babel-loader": "7",
    "css-loader": "^1.0.0",
    "electron": "^40.4.1",
    "electron-builder": "26.7.0",
    "html-webpack-plugin": "^3.0.6",
    "ico": "^0.3.3",
    "json-loader": "^0.5.7",
    "moment": "^2.21.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^1.11.1",
    "sharp": "^0.34.5",
    "source-map-loader": "^0.2.1",
    "style-loader": "^0.23.0",
    "ts-loader": "^5.1.0",
    "typescript": "^3.4.1",
    "webpack": "^4.1.1",
    "webpack-cli": "^3.1.0",
    "webpack-dev-server": "^3.11.3"
  },
  "resolutions": {
    "@types/react": "15.6.7"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "build": {
    "appId": "com.battle-city.game",
    "productName": "坦克大战",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "resources/icon.ico"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "坦克大战",
      "deleteAppDataOnUninstall": true
    },
    "electronDownload": {
      "cache": "./electron-cache"
    }
  },
  "packageManager": "yarn@4.9.1"
}
